{
  "sqltools.connections": [
    {
      "previewLimit": 50,
      "driver": "SQLite",
      "name": "sqlite_security_course",
      "database": "./storage.db"
    }
  ],
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv",
  "cSpell.words": ["AppKit", "objc", "PyObjC", "NSToolbar", "NSWindow"],
  "files.exclude": {
    "**/*.pyc": {"when": "$(basename).py"},
    "**/__pycache__": true,
    "**/*.pytest_cache": true
  }
}
