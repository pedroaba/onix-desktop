QWidget {
    color: #262626;
}

QMainWindow {
    background-color: #ffffff;
}

QLabel#PageTitle {
    color: #000000;
}

QLabel#PageDescription,
QLabel#LocalDescriptionLabel,
QLabel#AccountName {
    color: #616161;
}

QPushButton#PrimaryButton {
    background-color: #0067b8;
    color: #ffffff;
    border-color: #0067b8;
}

QPushButton#PrimaryButton:hover {
    background-color: #004a7f;
    border-color: #004a7f;
}

QPushButton#PrimaryButton:pressed {
    background-color: #00385f;
    border-color: #00385f;
}

QPushButton#PrimaryButton:focus {
    border-color: #262626;
}

QFrame#Sidebar {
    background-color: #f2f2f2;
    border-right-color: #dddddd;
}

QFrame#Sidebar QPushButton {
    background-color: transparent;
}

QFrame#Sidebar QPushButton:hover {
    background-color: #e5e5e5;
}

QFrame#Sidebar QPushButton:checked {
    background-color: #dceaf7;
    color: #0067b8;
}

QFrame#Sidebar QPushButton:focus {
    border-color: #0067b8;
}

QTableView#FolderTable {
    background-color: #ffffff;
    color: #262626;
    selection-background-color: #dceaf7;
    selection-color: #262626;
}

QTableView#FolderTable::item {
    border-bottom-color: #eeeeee;
}

QTableView#FolderTable QHeaderView::section {
    background-color: #ffffff;
    color: #616161;
    border-bottom-color: #dddddd;
}

QFrame#FolderDetails {
    background-color: #ffffff;
    border-left-color: #dddddd;
}

QFrame#TitleBar {
    background-color: #f2f2f2;
    border-bottom-color: #dddddd;
}

QLineEdit#SearchInput {
    background-color: #ffffff;
    color: #262626;
    border-color: #b7b7b7;
}

QLineEdit#SearchInput:focus {
    border-color: #0067b8;
}

QLabel#EmptyStateDescription {
    color: #616161;
}

QLabel#AccountSubtitle {
    color: #616161;
}

QFrame#NavigationIndicator {
    background-color: #0067b8;
}

QLabel#ResultsSummary {
    color: #616161;
}

QLabel#PageBreadcrumb {
    color: #616161;
}

QPushButton#SyncButton {
    background-color: #ffffff;
    color: #0067b8;
    border-color: #b7b7b7;
}

QPushButton#SyncButton:hover {
    background-color: #f2f2f2;
}

QPushButton#SyncButton:pressed {
    background-color: #e5e5e5;
}

QPushButton#SyncButton:focus {
    border-color: #0067b8;
}

QPushButton[role="view-mode"] {
    background-color: #ffffff;
    border-color: #dddddd;
}

QPushButton[role="view-mode"]:hover {
    background-color: #f2f2f2;
}

QPushButton[role="view-mode"]:checked {
    background-color: #dceaf7;
    border-color: #99caff;
}

QPushButton[role="view-mode"]:focus {
    border-color: #0067b8;
}

QPushButton[role="view-mode"]:disabled {
    background-color: #f5f5f5;
    border-color: #dddddd;
}

QLabel#SyncStatusText {
    color: #262626;
}

QLabel#SyncStatusTime {
    color: #616161;
}

QFrame#SyncStatusDivider {
    background-color: #dddddd;
}

QLabel#DetailsSubtitle,
QLabel[role="details-field-label"] {
    color: #616161;
}

QPushButton#CloseDetailsButton:hover {
    background-color: #eeeeee;
}

QPushButton#CloseDetailsButton:pressed {
    background-color: #dddddd;
}

QPushButton#CloseDetailsButton:focus {
    border-color: #0067b8;
}

QFrame#DetailsDivider {
    background-color: #dddddd;
}

QLabel#LocalStorageDescription {
    color: #616161;
}

QPushButton#FreeSpaceButton {
    background-color: #ffffff;
    color: #0067b8;
    border-color: #b7b7b7;
}

QPushButton#FreeSpaceButton:disabled {
    color: #969696;
    border-color: #dddddd;
}

QStatusBar#AppFooter {
    background-color: #ffffff;
    border-top-color: #dddddd;
}

QLabel#FooterCount,
QLabel#FooterConnection {
    color: #262626;
}

QFrame#StorageDivider {
    background-color: #dddddd;
}

QLabel#StorageUsage {
    color: #616161;
}

QProgressBar#StorageProgress {
    background-color: #d7d7d7;
}

QProgressBar#StorageProgress::chunk {
    background-color: #0067b8;
}



QFrame#AccountHeader {
  background-color: #ffffff;
  border-color: #dddddd;
}

QLabel#AccountSubtitle[connected="true"] {
  color: #107c10;
}

QFrame#Sidebar QPushButton#AccountConnectionButton {
  background-color: #0067b8;
  color: #ffffff;
}

QFrame#Sidebar QPushButton#AccountConnectionButton:hover {
  background-color: #004a7f;
}

QFrame#Sidebar QPushButton#AccountConnectionButton:pressed {
  background-color: #00385f;
}

QFrame#Sidebar QPushButton#AccountConnectionButton[connected="true"] {
  background-color: #ffffff;
  color: #616161;
  border-color: #b7b7b7;
}

QFrame#Sidebar QPushButton#AccountConnectionButton[connected="true"]:hover {
  background-color: #f2f2f2;
  color: #262626;
}

QFrame#Sidebar QPushButton#AccountConnectionButton[connected="true"]:pressed {
  background-color: #e5e5e5;
}

QFrame#Sidebar QPushButton#AccountConnectionButton:focus,
QFrame#Sidebar QPushButton#AccountConnectionButton[connected="true"]:focus {
  border-color: #262626;
}

QFrame#Sidebar QPushButton#AccountConnectionButton:disabled {
  background-color: #f5f5f5;
  color: #616161;
  border-color: #b7b7b7;
}
