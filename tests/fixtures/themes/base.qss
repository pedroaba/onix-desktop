QWidget {
  font-family: @font-family@;
  font-size: 13px;
}

QLabel#PageBreadcrumb {
  font-size: 12px;
}

QLabel#AppTitle {
  font-size: 14px;
  font-weight: 600;
}

QLabel#PageTitle {
  font-size: 24px;
  font-weight: 600;
}

QLabel#SidebarTitle,
QLabel#DetailsHeading {
  font-size: 14px;
  font-weight: 600;
}

QLabel#PageDescription {
  font-size: 13px;
}

QLabel#AccountName {
  font-size: 12px;
}

QLabel#AccountTitle {
  font-size: 14px;
  font-weight: 600;
}

QLabel#AccountSubtitle {
  font-size: 12px;
}

QPushButton#PrimaryButton {
  font-size: 14px;
  font-weight: 600;
  border: 1px solid transparent;
  border-radius: 6px;
  padding: 10px 16px;
}

QFrame#Sidebar {
  border: none;
  border-right: 1px solid transparent;
}

QFrame#Sidebar QPushButton {
  border: 1px solid transparent;
  border-radius: 6px;
  padding: 10px 12px;
  text-align: left;
}

QFrame#Sidebar QPushButton:checked {
  font-weight: 600;
}

QFrame#NavigationIndicator {
  border: none;
  border-radius: 6px;
}

QTableView#FolderTable {
  border: none;
}

QTableView#FolderTable::item {
  padding: 8px;
  border-bottom: 1px solid transparent;
}

QTableView#FolderTable QHeaderView::section {
  font-weight: 600;
  padding: 12px;
  border: none;
  border-bottom: 1px solid transparent;
}

QLabel#ResultsSummary {
  font-size: 12px;
  padding-top: 8px;
}

QTableView#FolderTable QHeaderView::section {
  font-weight: 400;
  padding: 12px;
  border: none;
  border-bottom: 1px solid transparent;
}

QFrame#TitleBar {
  border: none;
  border-bottom: 1px solid transparent;
}

QLineEdit#SearchInput {
  border: 1px solid transparent;
  border-radius: 6px;
  padding: 6px 12px;
}

QLabel#EmptyStateTitle {
  font-size: 14px;
  font-weight: 600;
}

QLabel#EmptyStateDescription {
  font-size: 12px;
}

QPushButton#SyncButton {
  font-size: 14px;
  font-weight: 400;
  border: 1px solid transparent;
  border-radius: 6px;
  padding: 10px 16px;
}

QLabel#SyncStatusText {
  font-size: 13px;
  font-weight: 600;
}

QLabel#SyncStatusTime {
  font-size: 12px;
}

QFrame#SyncStatusDivider {
  border: none;
}

QPushButton[role="view-mode"] {
  border: 1px solid transparent;
  border-radius: 6px;
  padding: 0;
}

QFrame#FolderDetails {
  border: none;
  border-left: 1px solid transparent;
  border-radius: 0;
}

QLabel#DetailsFolderName {
  font-size: 17px;
  font-weight: 600;
}

QLabel#DetailsSubtitle {
  font-size: 13px;
}

QLabel[role="details-field-label"] {
  font-size: 13px;
}

QPushButton#CloseDetailsButton {
  background-color: transparent;
  border: 1px solid transparent;
  border-radius: 6px;
  padding: 0;
}

QFrame#DetailsDivider {
  border: none;
}

QLabel#LocalStorageDescription {
  font-size: 12px;
}

QPushButton#FreeSpaceButton {
  border: 1px solid transparent;
  border-radius: 6px;
  padding: 8px 16px;
}

QLabel#LocalStorageHeading {
  font-size: 14px;
  font-weight: 600;
}

QFrame#StorageDivider {
  border: none;
}

QLabel#StorageHeading {
  font-size: 13px;
  font-weight: 600;
}

QLabel#StorageUsage {
  font-size: 12px;
  font-weight: 400;
}

QProgressBar#StorageProgress {
  border: none;
  border-radius: 8px;
}

QProgressBar#StorageProgress::chunk {
  border-radius: 8px;
}

QStatusBar#AppFooter {
  border: none;
  border-top: 1px solid transparent;
}

QStatusBar#AppFooter::item {
  border: none;
}

QLabel#FooterCount,
QLabel#FooterConnection {
  font-size: 12px;
}

QFrame#AccountHeader {
  border: 1px solid transparent;
  border-radius: 8px;
}

QFrame#Sidebar QPushButton#AccountConnectionButton {
  font-weight: 600;
  border: 1px solid transparent;
  border-radius: 8px;
  padding: 6px 12px;
  text-align: center;
}
