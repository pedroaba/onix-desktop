{
  "name": "onix-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 1420",
    "build": "next build",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint src",
    "tauri": "tauri",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src eslint.config.js prettier.config.mjs next.config.ts postcss.config.mjs",
    "format:check": "prettier --check src eslint.config.js prettier.config.mjs next.config.ts postcss.config.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.80.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19",
    "react-dom": "^19",
    "tailwind-merge": "^3.7.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@next/eslint-plugin-next": "16.4.6",
    "@tailwindcss/postcss": "4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "^24.19.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9",
    "typescript-eslint": "^8"
  },
  "engines": {
    "node": ">=24"
  }
}
