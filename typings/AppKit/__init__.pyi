"""Subset of AppKit used by this application's macOS adapter."""

from typing import Protocol, Self

from objc import objc_object

NSWindowToolbarStyleUnified: int
NSWindowTitleHidden: int

class _Size(Protocol):
    @property
    def height(self) -> float: ...

class _Rect(Protocol):
    @property
    def size(self) -> _Size: ...

class NSView(objc_object):
    def window(self) -> NSWindow: ...
    def bounds(self) -> _Rect: ...

class NSToolbar:
    @classmethod
    def alloc(cls) -> Self: ...
    def initWithIdentifier_(self, identifier: str) -> Self: ...
    def setShowsBaselineSeparator_(self, show: bool) -> None: ...

class NSWindow:
    def setToolbar_(self, toolbar: NSToolbar) -> None: ...
    def setToolbarStyle_(self, style: int) -> None: ...
    def setTitleVisibility_(self, visibility: int) -> None: ...
    def contentLayoutRect(self) -> _Rect: ...
