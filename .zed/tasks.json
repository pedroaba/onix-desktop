[
  {
    "label": "Onix: executar aplicativo",
    "command": "pnpm",
    "args": [
      "tauri",
      "dev"
    ],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "Onix: verificar tipos do frontend",
    "command": "pnpm",
    "args": [
      "typecheck"
    ],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "Onix: lint do frontend",
    "command": "pnpm",
    "args": [
      "lint"
    ],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "Onix: verificar formatação do frontend",
    "command": "pnpm",
    "args": [
      "format:check"
    ],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "Onix: verificar formatação do Rust",
    "command": "cargo",
    "args": [
      "fmt",
      "--manifest-path",
      "src-tauri/Cargo.toml",
      "--",
      "--check"
    ],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "Onix: verificar Rust com Clippy",
    "command": "cargo",
    "args": [
      "clippy",
      "--locked",
      "--manifest-path",
      "src-tauri/Cargo.toml",
      "--",
      "-D",
      "warnings"
    ],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "Onix: empacotar aplicativo",
    "command": "pnpm",
    "args": [
      "tauri",
      "build"
    ],
    "cwd": "$ZED_WORKTREE_ROOT"
  }
]
