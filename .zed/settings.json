{
  "file_scan_exclusions": [
    "...",
    "**/node_modules",
    "**/.next",
    "**/out",
    "**/src-tauri/target"
  ],
  "terminal": {
    "working_directory": "current_project_directory"
  },
  "languages": {
    "JavaScript": {
      "format_on_save": "on",
      "formatter": "auto",
      "prettier": {
        "allowed": true
      },
      "code_actions_on_format": {
        "source.fixAll.eslint": true
      }
    },
    "TypeScript": {
      "format_on_save": "on",
      "formatter": "auto",
      "prettier": {
        "allowed": true
      },
      "code_actions_on_format": {
        "source.fixAll.eslint": true
      }
    },
    "TSX": {
      "format_on_save": "on",
      "formatter": "auto",
      "prettier": {
        "allowed": true
      },
      "code_actions_on_format": {
        "source.fixAll.eslint": true
      }
    },
    "CSS": {
      "format_on_save": "on",
      "formatter": "auto",
      "prettier": {
        "allowed": true
      }
    }
  },
  "lsp": {
    "eslint": {
      "settings": {
        "codeActionOnSave": {
          "rules": [
            "simple-import-sort/imports"
          ]
        }
      }
    }
  }
}
